{
  "imports": [
    "./Palette.json",
    "./Panels.json",
    "./Controls.json"
  ],

  "Keyboard": "./Keyboard.json",
  "Envelope": "./Envelope.json",

  "background": "radial-gradient(at 50% 0%, #143222 0%, $night 70%)",
  "foreground": "$ink",
  "font-family": "Rubik",
  "font-size": 13,
  "transition": "background 150ms ease-out, foreground 150ms ease-out, border 150ms ease-out, opacity 250ms ease-in-out",

  "#title": {
    "font-family": "Rubik Mono One",
    "font-size": 24,
    "foreground": "$lime"
  },
  "#subtitle": {
    "font-size": 11,
    "foreground": "$muted"
  },
  "#logo": {
    ".body": {
      "stroke": "linear-gradient(to bottom right, $lime 0%, $leaf 55%, #1F8A4C 100%)"
    },
    ".head": {
      "fill": "linear-gradient(to bottom right, $lime 0%, $leaf 100%)"
    },
    ".markings": {
      "stroke": "$night"
    },
    ".eye": {
      "fill": "$night"
    },
    ".tongue": {
      "stroke": "$fang"
    },
    "shadow": "0 0 14px rgba(124, 242, 154, 0.35)"
  }
}
