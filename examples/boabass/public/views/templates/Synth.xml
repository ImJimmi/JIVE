<Component padding="20" gap="14" flex-grow="1">
    <Component id="header" flex-direction="row" align-items="center" gap="12">
        <svg id="logo" viewBox="0 0 40 40" width="44" height="44">
            <path class="tongue" d="M33 9h3.5M36.5 9l2-1.6M36.5 9l2 1.6" fill="none" stroke-width="1.2" stroke-linecap="round" />
            <path class="body" d="M5 34c9 1 25-1 25-8s-20-5-20-12 12-8 16-6" fill="none" stroke-width="6" stroke-linecap="round" />
            <path class="markings" d="M5 34c9 1 25-1 25-8s-20-5-20-12 12-8 16-6" fill="none" stroke-width="2" stroke-dasharray="1.5 4" stroke-linecap="round" />
            <ellipse class="head" cx="28" cy="8.5" rx="5.5" ry="4" />
            <ellipse class="eye" cx="29.5" cy="7.3" rx="1.1" ry="1.4" />
        </svg>
        <Component gap="2">
            <Text id="title">BoaBass</Text>
            <Text id="subtitle">subtitle</Text>
        </Component>

        <Component flex-grow="1" />

        <Component id="presets" flex-direction="row" align-items="center" gap="6">
            <Button id="previous-preset" class="arrow" padding="0" width="30" height="30" tooltip="previous-preset">
                <Image source="public/images/chevron-left.svg" width="16" height="16" />
            </Button>
            <ComboBox id="preset" width="200" height="30" />
            <Button id="next-preset" class="arrow" padding="0" width="30" height="30" tooltip="next-preset">
                <Image source="public/images/chevron-right.svg" width="16" height="16" />
            </Button>
        </Component>

        <Component flex-grow="1" />

        <Component flex-direction="row" align-items="center" gap="10">
            <ComboBox id="language" selected="0" width="110" height="30" tooltip="language">
                <Option lang="public/locales/english.strings">English</Option>
                <Option lang="public/locales/german.strings">Deutsch</Option>
                <Option lang="public/locales/french.strings">Français</Option>
                <Option lang="public/locales/spanish.strings">Español</Option>
                <Option lang="public/locales/italian.strings">Italiano</Option>
                <Option lang="public/locales/portuguese.strings">Português</Option>
                <Option lang="public/locales/dutch.strings">Nederlands</Option>
                <Option lang="public/locales/japanese.strings">日本語</Option>
                <Option lang="public/locales/chinese.strings">简体中文</Option>
                <Option lang="public/locales/korean.strings">한국어</Option>
            </ComboBox>
            <Component template="public/views/templates/Knob.xml" label="volume" parameter="volume" size="small" diameter="38" width="80" />
            <Meter id="meter" value="0" width="10" height="64" />
        </Component>
    </Component>

    <Component class="row" flex-direction="row" gap="14">
        <Component template="public/views/templates/Panel.xml" title="osc-1" grow="1.2">
            <Snippet name="header">
                <Component template="public/views/templates/Waves.xml" parameter="osc1-wave" />
            </Snippet>
            <Snippet name="body">
                <Component template="public/views/templates/Knob.xml" label="octave" parameter="osc1-octave" />
                <Component template="public/views/templates/Knob.xml" label="detune" parameter="osc1-detune" />
                <Component template="public/views/templates/Knob.xml" label="level" parameter="osc1-level" />
            </Snippet>
        </Component>

        <Component template="public/views/templates/Panel.xml" title="osc-2" grow="1.2" switched-by="osc2-on">
            <Snippet name="header">
                <Component flex-direction="row" align-items="center" gap="10">
                    <Component template="public/views/templates/Waves.xml" parameter="osc2-wave" />
                    <Component template="public/views/templates/Power.xml" parameter="osc2-on" />
                </Component>
            </Snippet>
            <Snippet name="body">
                <Component template="public/views/templates/Knob.xml" label="octave" parameter="osc2-octave" />
                <Component template="public/views/templates/Knob.xml" label="detune" parameter="osc2-detune" />
                <Component template="public/views/templates/Knob.xml" label="level" parameter="osc2-level" />
            </Snippet>
        </Component>

        <Component template="public/views/templates/Panel.xml" title="sub-noise" switched-by="sub-on">
            <Snippet name="header">
                <Component flex-direction="row" align-items="center" gap="10">
                    <Component class="choices" parameter="sub-wave" flex-direction="row" gap="4">
                        <Component template="public/views/templates/WaveButton.xml" wave="sine" />
                        <Component template="public/views/templates/WaveButton.xml" wave="square" />
                    </Component>
                    <Component template="public/views/templates/Power.xml" parameter="sub-on" />
                </Component>
            </Snippet>
            <Snippet name="body">
                <Component template="public/views/templates/Knob.xml" label="sub" parameter="sub-level" />
                <Component template="public/views/templates/Knob.xml" label="noise" parameter="noise-level" />
            </Snippet>
        </Component>
    </Component>

    <Component class="row" flex-direction="row" gap="14">
        <Component template="public/views/templates/Panel.xml" title="filter" grow="1.6">
            <Snippet name="header">
                <Component class="choices" parameter="filter-mode" flex-direction="row" gap="4">
                    <Button class="choice" toggleable="true" padding="5 9" tooltip="low-pass">lp</Button>
                    <Button class="choice" toggleable="true" padding="5 9" tooltip="band-pass">bp</Button>
                    <Button class="choice" toggleable="true" padding="5 9" tooltip="high-pass">hp</Button>
                </Component>
            </Snippet>
            <Snippet name="body">
                <Component template="public/views/templates/Knob.xml" label="cutoff" parameter="filter-cutoff" size="large" diameter="76" width="96" />
                <Component template="public/views/templates/Knob.xml" label="resonance" parameter="filter-resonance" />
                <Component template="public/views/templates/Knob.xml" label="drive" parameter="filter-drive" />
                <Component template="public/views/templates/Knob.xml" label="env-amount" parameter="filter-env-amount" width="80" />
                <Component template="public/views/templates/Knob.xml" label="key-track" parameter="filter-key-track" />
            </Snippet>
        </Component>

        <Component template="public/views/templates/EnvelopePanel.xml" title="filter-envelope" prefix="filter" />
        <Component template="public/views/templates/EnvelopePanel.xml" title="amp-envelope" prefix="amp" />
    </Component>

    <Component class="row" flex-direction="row" gap="14">
        <Component template="public/views/templates/Panel.xml" title="lfo" grow="1.3" switched-by="lfo-on" justify="center" gap="32">
            <Snippet name="header">
                <Component flex-direction="row" align-items="center" gap="10">
                    <Component template="public/views/templates/Waves.xml" parameter="lfo-wave" />
                    <Component template="public/views/templates/Power.xml" parameter="lfo-on" />
                </Component>
            </Snippet>
            <Snippet name="body">
                <Component class="control" align-items="center" gap="8">
                    <ComboBox parameter="lfo-target" height="30">
                        <Option>cutoff</Option>
                        <Option>pitch</Option>
                        <Option>amp</Option>
                    </ComboBox>
                    <Text class="caption">target</Text>
                </Component>
                <Component template="public/views/templates/Knob.xml" label="rate" parameter="lfo-rate" />
                <Component template="public/views/templates/Knob.xml" label="depth" parameter="lfo-depth" />
            </Snippet>
        </Component>

        <Component template="public/views/templates/Panel.xml" title="voicing" grow="0.7" justify="center" gap="32">
            <Snippet name="body">
                <Component template="public/views/templates/Knob.xml" label="voices" parameter="voices" />
                <Component template="public/views/templates/Knob.xml" label="glide" parameter="glide" />
            </Snippet>
        </Component>
    </Component>

    <Keyboard id="keyboard" flex-grow="1" min-height="80" />
</Component>
