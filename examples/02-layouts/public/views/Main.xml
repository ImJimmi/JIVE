<Window
    width="1000"
    height="780"
    min-height="720"
    min-width="900"
    padding="25"
    resizable="true"
    theme="steel"
    style="public/styles/Styles.json"
>
    <Component id="content" max-width="1280" align-self="center" flex-grow="1">
        <Component display="grid" grid-template-columns="1fr auto 1fr" align-items="center" margin="0 0 25 0">
            <Component />
            <Text id="title">Layouts</Text>
            <Component flex-direction="row" justify-content="flex-end" align-items="center" gap="10">
                <Label>Theme</Label>

                <ComboBox id="theme-combo-box">
                    <Option>Steel</Option>
                    <Option>Material</Option>
                    <Option>Synthwave</Option>
                    <Option>High-contrast</Option>
                    <Option>JUCE</Option>
                </ComboBox>
            </Component>
        </Component>

        <Text margin="0 0 25 0">JIVE has three layout options — Flex, Grid, and Absolute. Use the controls below to see how they each work.</Text>

        <Component flex-direction="row" gap="10" margin="0 0 25 0" align-self="center">
            <Button id="flex-tab" radio-group="1" toggle-on-click="true" toggled="true" padding="4 12">Flex</Button>
            <Button id="grid-tab" radio-group="1" toggle-on-click="true" padding="4 12">Grid</Button>
            <Button id="absolute-tab" radio-group="1" toggle-on-click="true" padding="4 12">Absolute</Button>
        </Component>

        <Component id="page" template="public/views/Flex.xml" flex-grow="1" />
    </Component>
</Window>
