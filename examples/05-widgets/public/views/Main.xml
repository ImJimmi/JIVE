<Editor
    width="1000"
    height="780"
    padding="25"
    theme="steel"
    style="public/styles/Styles.json"
>
    <Component id="content" max-width="1280" align-self="center" flex-grow="1">
        <Component display="grid" grid-template-columns="1fr auto 1fr" align-items="center" margin="0 0 25 0">
            <Component />
            <Text id="title">Widgets</Text>
            <Component flex-direction="row" justify-content="flex-end" align-items="center" gap="10">
                <Label>Theme</Label>

                <ComboBox id="theme-combo-box">
                    <Option>Steel</Option>
                    <Option>Material</Option>
                    <Option>Synthwave</Option>
                    <Option>High-contrast</Option>
                    <Option>JUCE</Option>
                </ComboBox>
            </Component>
        </Component>

        <Text margin="0 0 25 0">JIVE provides handles for all the basic components provided by JUCE, as well as callbacks to allow you to respond to their value changes, all without having to directly access the component class itself. This allows us to have a clear separation between our "View" layers and our "Controller" layers.</Text>

        <Component flex-direction="row" gap="10" margin="0 0 25 0" align-self="center">
            <Button id="gallery-tab" radio-group="1" toggle-on-click="true" toggled="true" padding="4 12">Gallery</Button>
            <Button id="custom-tab" radio-group="1" toggle-on-click="true" padding="4 12">Custom</Button>
        </Component>

        <Component id="page" source="public/views/Gallery.xml" flex-grow="1" />
    </Component>
</Editor>
