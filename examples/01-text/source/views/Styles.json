{
  "background": "#1E2125",
  "foreground": "#E6E8EA",
  "font-family": "Rubik",
  "font-size": 14,

  "#title": {
    "font-family": "Rubik Mono One",
    "font-size": 40,
    "foreground": "#4FADE4"
  },
  "#font-size-controls": {
    "font-size": 14
  },
  ".value": {
    "font-family": "Source Code Pro"
  },
  "#rubik-option": {
    "font-family": "Rubik"
  },
  "#helvetica-option": {
    "font-family": "Helvetica"
  },
  "#georgia-option": {
    "font-family": "Georgia"
  },
  "#bold-checkbox": {
    "font-styles": "bold"
  },
  "#italic-checkbox": {
    "font-styles": "italic"
  },
  "#underlined-checkbox": {
    "font-styles": "underlined"
  },
  "#lead": {
    "font-size": 17
  },
  ".heading": {
    "font-family": "Rubik Mono One",
    "font-size": 14,
    "foreground": "#4FADE4"
  },
  ".caption": {
    "font-family": "Source Code Pro",
    "font-size": 12,
    "foreground": "#8A9199"
  },
  ".sample": {
    "background": "#16191C"
  },

  ".align-left": {
    "text-align": "centred-left"
  },
  ".align-centre": {
    "text-align": "centred"
  },
  ".align-right": {
    "text-align": "centred-right"
  },
  ".right-to-left": {
    "font-size": 18,
    "text-align": "centred-right"
  },

  ".georgia": {
    "font-family": "Georgia",
    "font-size": 18
  },
  ".rubik": {
    "font-family": "Rubik",
    "font-size": 18
  },
  ".rubik-mono-one": {
    "font-family": "Rubik Mono One",
    "font-size": 18
  },
  ".source-code-pro": {
    "font-family": "Source Code Pro",
    "font-size": 18
  },

  ".size-12": {
    "font-size": 12
  },
  ".size-18": {
    "font-size": 18
  },
  ".size-24": {
    "font-size": 24
  },
  ".size-36": {
    "font-size": 36
  },

  ".kerning-tight": {
    "font-kerning": -0.05,
    "font-size": 18
  },
  ".kerning-wide": {
    "font-kerning": 0.2,
    "font-size": 18
  },
  ".scale-narrow": {
    "font-scale": 0.7,
    "font-size": 18
  },
  ".scale-wide": {
    "font-scale": 1.5,
    "font-size": 18
  },

  ".metrics": {
    "background": "#2E5A75",
    "font-size": 18
  },
  ".ascent": {
    "font-ascent-override": 1.4
  },
  ".descent": {
    "font-descent-override": 0.8
  },

  ".red": {
    "foreground": "#E77674",
    "font-size": 18
  },
  ".green": {
    "foreground": "#74B670",
    "font-size": 18
  },
  ".blue": {
    "foreground": "#70CDFF",
    "font-size": 18
  },

  "#inherited": {
    "font-family": "Source Code Pro",
    "foreground": "#BE89DD"
  }
}
