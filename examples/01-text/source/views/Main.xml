<Window
    height="500"
    min-height="350"
    min-width="600"
    padding="25"
    resizable="true"
    style="Styles.json"
    width="800"
>
    <Component id="content">
        <Text id="title" margin="0 0 25 0" align-self="center">Text</Text>

        <Text margin="0 0 5 0">Unlike in stock JUCE UIs, Text elements in JIVE are automatically sized. The UI will automatically update to accommodate new text, or a different font. Use the options below to customise the font used for this text to see it in action.</Text>
        <Text margin="0 0 5 0">This sentence is a separate Text element which always fits neatly below the first paragraph no matter what font options you choose.</Text>

        <Component margin="15">
            <Text class="heading" margin="0 0 10 0">Options</Text>

            <Component display="grid" grid-template-columns="auto 1fr auto" gap="10 15" align-items="center">
                <Label>Font Size</Label>
                <Slider id="font-size-slider" min="12" max="18" interval="0.1" value="14" />
                <Text id="font-size-label" class="value" accessible="false">14.0pt</Text>

                <Label>Font Family</Label>
                <ComboBox id="font-family-combo-box" grid-column="2 / span 2" grid-row="2 / 3">
                    <Option id="rubik-option">Rubik</Option>
                    <Option id="helvetica-option">Helvetica</Option>
                    <Option id="georgia-option">Georgia</Option>
                </ComboBox>

                <Label>Font Styles</Label>
                <Component flex-direction="row" gap="15" grid-column="2 / span 2" grid-row="3 / 4">
                    <Checkbox id="bold-checkbox" toggle-on-click="true">Bold</Checkbox>
                    <Checkbox id="italic-checkbox" toggle-on-click="true">Italic</Checkbox>
                    <Checkbox id="underlined-checkbox" toggle-on-click="true">Underlined</Checkbox>
                </Component>

                <Label>Kerning</Label>
                <Slider id="font-kerning-slider" min="-0.1" max="0.3" interval="0.01" value="0" />
                <Text id="font-kerning-label" class="value" accessible="false">0.00</Text>

                <Label>Scale</Label>
                <Slider id="font-scale-slider" min="0.5" max="1.5" interval="0.01" value="1" />
                <Text id="font-scale-label" class="value" accessible="false">1.00x</Text>
            </Component>
        </Component>

