{
  "$carbonBlack": "#16191C",
  "$eerieBlack": "#1E2125",
  "$jetBlack": "#24272A",
  "$lightCoral": "#E77674",
  "$goldenApricot": "#D8924D",
  "$oldGold": "#AFAF3F",
  "$mossGreen": "#74B670",
  "$skyBlue": "#70CDFF",
  "$mayaBlue": "#60BDF5",
  "$pictonBlue": "#4FADE4",
  "$bluebell": "#3D9DD3",
  "$brightLavender": "#BE89DD",
  "$widgetShadow": "2px 2px 6px rgba(0, 0, 0, 0.25)",
  "#title": {
    "font-family": "Rubik Mono One",
    "font-size": 40,
    "foreground": "$pictonBlue"
  },
  "#side-bar": {
    "background": "$carbonBlack",
    "border-radius": "0",
    "shadow": "2px 0px 6px rgba(0, 0, 0, 0.25)"
  },
  "Button": {
    "background": "transparentWhite",
    "border": "",
    "fill": "white",
    "foreground": "white",
    "shadow": "",
    ":hover": {
      "background": "rgba(255, 255, 255, 0.05)"
    },
    ":checked": {
      "background": "linear-gradient(-10deg, $mayaBlue, $pictonBlue, $bluebell)",
      "fill": "black",
      "foreground": "black",
      "shadow": "$widgetShadow",
      ":hover": {
        "background": "linear-gradient(-10deg, $skyBlue, $mayaBlue, $pictonBlue)"
      }
    }
  },
  ".demo-title": {
    "font-family": "Rubik Mono One",
    "font-size": 25,
    "foreground": "$pictonBlue"
  },
  ".demo-name": {
    "font-size": 20
  },
  ".demo-label": {
    "font-size": 16
  },
  ".demo-container": {
    "background": "$carbonBlack",
    "border-radius": 15
  },
  ".box-red": {
    "background": "$lightCoral"
  },
  ".box-orange": {
    "background": "$goldenApricot"
  },
  ".box-yellow": {
    "background": "$oldGold"
  },
  ".box-green": {
    "background": "$mossGreen"
  },
  ".box-blue": {
    "background": "$pictonBlue"
  },
  ".box-purple": {
    "background": "$brightLavender"
  }
}
