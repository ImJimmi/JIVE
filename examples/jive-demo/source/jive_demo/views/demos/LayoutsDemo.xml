<Component>
    <Text class="demo-title" margin="0 0 20 0">Layouts</Text>

    <Text class="demo-name" margin="0 0 5 0">Flex Box</Text>

    <Component display="grid" grid-template-columns="1fr 1fr" gap="20">
        <Component padding="10 0 0 0">
            <Component flex-direction="row" align-items="start" justify-content="space-between">
                <Component margin="4 0 0 0">
                    <Text class="demo-label">
                        Direction
                    </Text>

                    <Text id="flex-direction-label" class="demo-label">row</Text>
                </Component>

                <Component align-self="start" flex-direction="row" gap="2" margin="0 0 7 0">
                    <Button id="flex-direction-row" min-width="0" min-height="0" radio-group="1"
                        toggle-on-click="true" toggled="true">
                        <Component source="views/icons/arrow-small-right.svg" />
                    </Button>
                    <Button id="flex-direction-column" min-width="0" min-height="0"
                        radio-group="1"
                        toggle-on-click="true">
                        <Component source="views/icons/arrow-small-down.svg" />
                    </Button>
                    <Button id="flex-direction-row-reverse" min-width="0" min-height="0"
                        radio-group="1"
                        toggle-on-click="true">
                        <Component source="views/icons/arrow-small-left.svg" />
                    </Button>
                    <Button id="flex-direction-column-reverse" min-width="0" min-height="0"
                        radio-group="1"
                        toggle-on-click="true">
                        <Component source="views/icons/arrow-small-up.svg" />
                    </Button>
                </Component>
            </Component>
        </Component>

        <Component id="flex-demo-container" class="demo-container" padding="10" flex-direction="row"
            height="135" gap="5">
            <Component class="box box-red" width="35" height="35" />
            <Component class="box box-orange" width="35" height="35" />
            <Component class="box box-yellow" width="35" height="35" />
            <Component class="box box-green" width="35" height="35" />
            <Component class="box box-blue" width="35" height="35" />
            <Component class="box box-purple" width="35" height="35" />
        </Component>
    </Component>
</Component>
