{
  "$accent": "#4FADE4",
  "$radius": 6,

  "Button, Checkbox, ComboBox": {
    "border-radius": "$radius"
  },
  ".toggle:checked": {
    "background": "$accent",
    "border": "$accent",
    "shadow": "0 0 12px $accent"
  },
  "Checkbox:checked": {
    "background": "$accent",
    "border": "$accent"
  }
}
